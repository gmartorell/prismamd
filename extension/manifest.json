{
  "manifest_version": 3,
  "name": "PrismaMD — Fast Markdown Editor",
  "version": "2026.11.16.3",
  "description": "Editor Markdown rápido y bidireccional (Raw + Vista Previa WYSIWYG + Mermaid + KaTeX) con Panel Lateral y Visor .md.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir PrismaMD",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html?mode=sidepanel"
  },
  "content_scripts": [
    {
      "matches": [
        "file://*/*.md*",
        "file://*/*.markdown*",
        "file://*/*.mdown*",
        "file://*/*.mdx*",
        "*://*/*.md*",
        "*://*/*.markdown*",
        "*://*/*.mdown*",
        "*://*/*.mdx*"
      ],
      "js": [
        "mdViewerContent.js"
      ],
      "run_at": "document_end"
    }
  ]
}
