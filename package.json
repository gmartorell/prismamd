{
  "name": "prismamd",
  "version": "2026.11.16-4",
  "private": true,
  "license": "MIT",
  "author": "Guillem Martorell Nicolau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmartorell/prismamd.git"
  },
  "homepage": "https://github.com/gmartorell/prismamd#readme",
  "type": "module",
  "description": "Fast multiplatform bidirectional Markdown editor (Chromium MV3 Extension + Offline PWA)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "build:pwa": "BUILD_TARGET=pwa vite build && node scripts/finalize-pwa.mjs",
    "build:ext": "BUILD_TARGET=extension vite build && node scripts/finalize-extension.mjs",
    "build": "npm run typecheck && npm run build:pwa && npm run build:ext",
    "preview:pwa": "vite preview --outDir dist-pwa --port 4173"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-code-block": "3.34.0",
    "@tiptap/extension-code-block-lowlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-preact": "^1.73.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "preact": "^11.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "^5.1.0"
  }
}
